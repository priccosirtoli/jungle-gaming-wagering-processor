{
  "name": "jungle-gaming-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "migrate": "bun run src/infrastructure/database/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/database/migrate.ts down",
    "demo": "bun run scripts/demo.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 30000 test/integration",
    "test:concurrency": "bun test --timeout 180000 test/concurrency"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1153.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
